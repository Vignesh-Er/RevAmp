# =========================================================================
# DIGIMATION FLIGHT — CONSOLIDATED .ENV.EXAMPLE
# Monorepo Environment Variables Configuration (RevampX Challenge 2026)
# =========================================================================

# -------------------------------------------------------------------------
# EXPRESS API SERVICE ENVIRONMENT (services/express-api/)
# -------------------------------------------------------------------------
# Port for the Express.js Server
PORT=5000

# Environment Mode ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster URI)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_name>.mongodb.net/digimation?retryWrites=true&w=majority

# OpenAI API Key (or Anthropic API Key) for AI Resume & Skills Gap Analyzer
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed CORS Origins (comma-separated domains)
ALLOWED_ORIGINS=http://localhost:3000,https://www.digimationflight.com

# HubSpot Developer API Key (or OAuth Portal Access Token)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Brevo API Key for Automated Email & SMS Messaging Channels
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brevo WhatsApp Verified Outbound Sender Number (e.g. 919876543210 without + symbol)
BREVO_WHATSAPP_SENDER=919876543210


# -------------------------------------------------------------------------
# NEXT.JS MARKETING APPLICATION ENVIRONMENT (apps/web-marketing/)
# -------------------------------------------------------------------------
# Base URL for Express.js API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Analytics 4 Measurement ID (consent-gated)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Microsoft Clarity Project Tracking Token (consent-gated)
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Verified Outbound WhatsApp Destination Number (format: 919XXXXXXXXX without + symbol)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# CookieYes Customer Portal Banner Token ID
NEXT_PUBLIC_COOKIEYES_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
